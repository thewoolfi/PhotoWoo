<Window x:Class="PhotoWoo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interactions="clr-namespace:PhotoWoo.Interactions"
        Title="PhotoWoo" Width="1200" Height="800" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#17191B" Foreground="#E7E9E9"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Closing="Window_Closing"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#A9C8BD" />
        <SolidColorBrush x:Key="MutedBrush" Color="#969D9F" />
        <SolidColorBrush x:Key="LineBrush" Color="#303437" />

        <Style x:Key="FocusOutline" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                CornerRadius="4" Margin="-2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#303437" />
            <Setter Property="Foreground" Value="#E7E9E9" />
            <Setter Property="BorderBrush" Value="#454B4E" />
            <Setter Property="Padding" Value="9,5" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5DADB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Border x:Name="ButtonHover" Background="#2D3235" CornerRadius="3"
                                        IsHitTestVisible="False" interactions:ControlFeedback.FadeTo="0" />
                                <Border x:Name="ButtonPress" Background="#3A4143" CornerRadius="3"
                                        IsHitTestVisible="False" interactions:ControlFeedback.FadeTo="0" />
                                <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonHover" Property="interactions:ControlFeedback.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonPress" Property="interactions:ControlFeedback.FadeTo" Value="1" />
                                <Setter TargetName="ButtonContent" Property="interactions:ControlFeedback.PressOffset" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonHover" Property="interactions:ControlFeedback.FadeTo" Value="0" />
                                <Setter TargetName="ButtonPress" Property="interactions:ControlFeedback.FadeTo" Value="0" />
                                <Setter TargetName="ButtonContent" Property="interactions:ControlFeedback.PressOffset" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Border x:Name="IconHover" Background="#2D3235" CornerRadius="3"
                                        IsHitTestVisible="False" interactions:ControlFeedback.FadeTo="0" />
                                <Border x:Name="IconPress" Background="#3A4143" CornerRadius="3"
                                        IsHitTestVisible="False" interactions:ControlFeedback.FadeTo="0" />
                                <Viewbox x:Name="IconContent" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconHover" Property="interactions:ControlFeedback.FadeTo" Value="1" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconPress" Property="interactions:ControlFeedback.FadeTo" Value="1" />
                                <Setter TargetName="IconContent" Property="interactions:ControlFeedback.PressOffset" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="IconHover" Property="interactions:ControlFeedback.FadeTo" Value="0" />
                                <Setter TargetName="IconPress" Property="interactions:ControlFeedback.FadeTo" Value="0" />
                                <Setter TargetName="IconContent" Property="interactions:ControlFeedback.PressOffset" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ThumbnailItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="108" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#AEB5B7" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Border x:Name="ItemHover" Background="#292F31" CornerRadius="3"
                                        IsHitTestVisible="False" interactions:ControlFeedback.FadeTo="0" />
                                <Border x:Name="ItemSelection" Background="#25312D" Margin="-1"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4"
                                        IsHitTestVisible="False" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemHover" Property="interactions:ControlFeedback.FadeTo" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSelection" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#E5EDEA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="HeaderChrome" Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="20"
                Background="#1D2022" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/PhotoWoo-logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PhotoWoo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ToolbarSeparator}" Margin="22,0" />
                <TextBlock x:Name="FileNameText" Grid.Column="2" Text="{DynamicResource L10n.main.viewer}"
                           Foreground="#B3BABC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DirtyText" Grid.Column="3" Text="{DynamicResource L10n.main.dirty}" Visibility="Collapsed"
                           Foreground="#D4B17C" FontSize="12" VerticalAlignment="Center" Margin="16,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="UpdateButton" Style="{StaticResource QuietButton}" Visibility="Collapsed" Foreground="#A9C8BD"
                            Content="{DynamicResource L10n.updates.button}" Click="Update_Click" />
                    <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Tag="M3,7 L3,5 Q3,4 4,4 L9,4 11,7 20,7 Q21,7 21,8 L21,10 M3,9 L21,9 18,20 3,20 Z"
                            Click="Open_Click" ToolTip="{DynamicResource L10n.main.openTip}" AutomationProperties.Name="{DynamicResource L10n.main.open}" />
                    <Button x:Name="FilmstripButton" Style="{StaticResource IconButton}" Tag="M5,4 L19,4 Q21,4 21,6 L21,18 Q21,20 19,20 L5,20 Q3,20 3,18 L3,6 Q3,4 5,4 Z M3,15 L21,15 M9,15 L9,20 M15,15 L15,20"
                            Click="Filmstrip_Click" ToolTip="{DynamicResource L10n.main.filmstrip}" AutomationProperties.Name="{DynamicResource L10n.main.filmstrip}" />
                    <Button x:Name="InfoButton" Style="{StaticResource IconButton}" Tag="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M12,11 L12,17 M12,6 L12,7"
                            Click="Info_Click" ToolTip="{DynamicResource L10n.main.info}" AutomationProperties.Name="{DynamicResource L10n.main.info}" />
                    <Button Style="{StaticResource IconButton}" Tag="M5,6 L19,6 M5,12 L19,12 M5,18 L19,18 M9,3 L9,9 M15,9 L15,15 M10,15 L10,21"
                            Click="Settings_Click" ToolTip="{DynamicResource L10n.main.settings}" AutomationProperties.Name="{DynamicResource L10n.main.settings}" />
                    <Button x:Name="SupportButton" Style="{StaticResource IconButton}" Foreground="#D5B7A7"
                            Tag="M3,5 L18,5 18,14 Q18,19 13,19 L8,19 Q3,19 3,14 Z M18,7 L20,7 Q24,7 24,11 Q24,15 18,15 M6,22 L20,22 M10,9 C7,6 5,10 10,14 C15,10 13,6 10,9"
                            Click="Support_Click" ToolTip="{DynamicResource L10n.main.support}" AutomationProperties.Name="{DynamicResource L10n.main.support}" />
                </StackPanel>
            </Grid>
        </Border>

            <Grid x:Name="PhotoStage" Grid.Row="1" Grid.Column="0" Background="#17191B">
                <Border x:Name="Viewport" ClipToBounds="True" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                        SizeChanged="Viewport_SizeChanged" MouseWheel="Viewport_MouseWheel"
                        MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseMove="Viewport_MouseMove"
                        MouseLeftButtonUp="Viewport_MouseLeftButtonUp" LostMouseCapture="Viewport_LostMouseCapture">
                    <Canvas>
                        <Image x:Name="PhotoImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                </Border>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" Margin="24">
                    <Image Source="Assets/PhotoWoo-logo.png" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,25" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{DynamicResource L10n.main.emptyTitle}" FontSize="23" FontWeight="Light" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L10n.main.emptyHint}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource L10n.main.formats}" FontSize="11" Foreground="#687173"
                               HorizontalAlignment="Center" Margin="0,26,0,0" />
                </StackPanel>

                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Tag="M14,6 L8,12 14,18"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                        Background="#222729" Click="Prev_Click" ToolTip="{DynamicResource L10n.main.previous}"
                        AutomationProperties.Name="{DynamicResource L10n.main.previous}" />
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Tag="M10,6 L16,12 10,18"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="#222729" Click="Next_Click" ToolTip="{DynamicResource L10n.main.next}"
                        AutomationProperties.Name="{DynamicResource L10n.main.next}" />

                <Border x:Name="StatusOverlay" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="20" Background="#E6222729"
                        BorderBrush="#3D4547" BorderThickness="1" CornerRadius="4" Padding="14,8"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="LoadingText" Text="{DynamicResource L10n.main.opening}" Foreground="#CDD8D4" FontSize="12" />
                </Border>
            </Grid>

            <Border x:Name="ToolbarChrome" Grid.Row="2" Grid.Column="0" Panel.ZIndex="20"
                    Background="#1D2022" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Center" Focusable="False" Padding="10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Tag="M5,12 L19,12" Click="ZoomOut_Click"
                                ToolTip="{DynamicResource L10n.main.zoomOut}" AutomationProperties.Name="{DynamicResource L10n.main.zoomOut}" />
                        <TextBlock x:Name="ZoomText" Text="—" Width="52" TextAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#B9C0C2" />
                        <Button Style="{StaticResource IconButton}" Tag="M5,12 L19,12 M12,5 L12,19" Click="ZoomIn_Click"
                                ToolTip="{DynamicResource L10n.main.zoomIn}" AutomationProperties.Name="{DynamicResource L10n.main.zoomIn}" />
                        <Button Style="{StaticResource IconButton}" Tag="M8,3 L3,3 3,8 M16,3 L21,3 21,8 M3,16 L3,21 8,21 M21,16 L21,21 16,21 M7,7 L17,7 17,17 7,17 Z" Click="Fit_Click"
                                ToolTip="{DynamicResource L10n.main.fit}" AutomationProperties.Name="{DynamicResource L10n.main.fit}" />
                        <Border Style="{StaticResource ToolbarSeparator}" />
                        <Button Style="{StaticResource IconButton}" Tag="M4,10 A8,8 0 1 1 5,18 M4,4 L4,10 10,10" Click="RotateLeft_Click"
                                ToolTip="{DynamicResource L10n.main.rotateLeft}" AutomationProperties.Name="{DynamicResource L10n.main.rotateLeft}" />
                        <Button Style="{StaticResource IconButton}" Tag="M20,10 A8,8 0 1 0 19,18 M20,4 L20,10 14,10" Click="RotateRight_Click"
                                ToolTip="{DynamicResource L10n.main.rotateRight}" AutomationProperties.Name="{DynamicResource L10n.main.rotateRight}" />
                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Tag="M8,4 L3,9 8,14 M3,9 L13,9 A6,6 0 0 1 13,21" Click="Undo_Click"
                                IsEnabled="False" ToolTip="{DynamicResource L10n.main.undo}" AutomationProperties.Name="{DynamicResource L10n.main.undo}" />
                        <Border Style="{StaticResource ToolbarSeparator}" />
                        <Button x:Name="SaveButton" Style="{StaticResource QuietButton}" Content="{DynamicResource L10n.main.save}" Click="Save_Click"
                                IsEnabled="False" Foreground="{StaticResource AccentBrush}" ToolTip="{DynamicResource L10n.main.saveTip}" />
                        <Button x:Name="SaveCopyButton" Style="{StaticResource QuietButton}" Content="{DynamicResource L10n.main.copy}" Click="SaveCopy_Click"
                                ToolTip="{DynamicResource L10n.main.copyTip}" />
                        <Border Style="{StaticResource ToolbarSeparator}" />
                        <Button x:Name="PrintButton" Style="{StaticResource IconButton}" Tag="M6,8 L6,3 18,3 18,8 M6,17 L3,17 3,9 21,9 21,17 18,17 M6,14 L18,14 18,21 6,21 Z M17,11 L18,11" Click="Print_Click"
                                ToolTip="{DynamicResource L10n.main.print}" AutomationProperties.Name="{DynamicResource L10n.main.print}" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Tag="M8,3 L3,3 3,8 M16,3 L21,3 21,8 M3,16 L3,21 8,21 M21,16 L21,21 16,21" Click="Full_Click"
                                ToolTip="{DynamicResource L10n.main.fullscreen}" AutomationProperties.Name="{DynamicResource L10n.main.fullscreen}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="InfoPanel" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Panel.ZIndex="20" Width="240" Visibility="Collapsed" ClipToBounds="True"
                    Background="#1D2022" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,24">
                <ScrollViewer Width="200" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L10n.main.information}" FontSize="10" FontWeight="SemiBold" Foreground="#909A9C" Margin="0,0,0,24" />
                        <TextBlock x:Name="InfoNameText" Text="{DynamicResource L10n.main.noImage}" FontSize="15"
                                   TextWrapping="Wrap" Margin="0,0,0,18" />
                        <TextBlock x:Name="InfoDetailsText" Foreground="#AEB7B9" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="22" />
                        <Border Background="{StaticResource LineBrush}" Height="1" Margin="0,24,0,20" />
                        <TextBlock Text="{DynamicResource L10n.main.rawHint}"
                                   Foreground="#859092" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                        <Button x:Name="FullQualityButton" Style="{StaticResource QuietButton}" Content="{DynamicResource L10n.main.fullQuality}"
                                Click="FullQuality_Click" Margin="0,16,0,0" HorizontalAlignment="Left"
                                BorderBrush="#3E4847" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        <Border x:Name="FilmstripBorder" Grid.Row="3" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed" Background="#1D2022" ClipToBounds="True"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,7,12,3">
            <ListBox x:Name="ThumbnailsList" Height="100" Background="Transparent" BorderThickness="0"
                     Foreground="#B2BABC" SelectionMode="Single" SelectionChanged="Thumbnails_SelectionChanged"
                     ScrollViewer.ScrollChanged="Thumbnails_ScrollChanged"
                     ItemContainerStyle="{StaticResource ThumbnailItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel" interactions:DragScrollBehavior.IsEnabled="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{DynamicResource L10n.main.folderImages}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="53" Background="#17191B" Margin="0,0,0,6">
                                <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform><RotateTransform Angle="{Binding Rotation}" /></Image.LayoutTransform>
                                </Image>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" ToolTip="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border x:Name="StatusChrome" Grid.Row="4" Grid.ColumnSpan="2" Panel.ZIndex="20"
                Background="#1A1D1F" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailsText" Text="" FontSize="11" Foreground="#808C8F" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{DynamicResource L10n.main.ready}" FontSize="11" Foreground="#808C8F"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0" />
                <TextBlock x:Name="PositionText" Grid.Column="2" Text="" FontSize="11" Foreground="#A8B2B4" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
